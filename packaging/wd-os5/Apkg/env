# Shared environment for every HSYNC lifecycle script.
#
# Sourced by install.sh / init.sh / start.sh / stop.sh / remove.sh / clean.sh
# and by the CGI scripts under web/.
#
# Variables here are CONSTANTS that describe the package and the on-disk
# layout. User-tweakable settings live in HSYNC_ENV_FILE (see below).

# Package identity
APKG_NAME="hsync"
BINARY="hsync"

# Persistent data root on the data volume (survives package upgrades).
HSYNC_ROOT="/mnt/HD/HD_a2/hsync"
HSYNC_DATA_DIR="${HSYNC_ROOT}/data"
HSYNC_CONFIG_DIR="${HSYNC_ROOT}/config"
HSYNC_LOG_DIR="${HSYNC_ROOT}/log"
HSYNC_RUN_DIR="${HSYNC_ROOT}/run"
HSYNC_ENV_FILE="${HSYNC_CONFIG_DIR}/hsync.env"
HSYNC_LOG_FILE="${HSYNC_LOG_DIR}/hsync.log"
HSYNC_PID_FILE="${HSYNC_RUN_DIR}/hsync.pid"

# Web UI is symlinked here by init.sh so it shows up under the stock
# apache docroot at http://<NAS>/${APKG_NAME}/.
WEB_ROOT="/var/www/${APKG_NAME}"
