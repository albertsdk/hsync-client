[Unit]
Description=HSYNC file synchronization client
Documentation=https://github.com/albertsdk/hsync-client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=_hsync
Group=_hsync
EnvironmentFile=-/etc/hsync/hsync.conf
ExecStart=/usr/lib/hsync/hsync lan --bucket ${HSYNC_BUCKET} --path ${HSYNC_PATH} --yes
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/hsync/hsync.log
StandardError=append:/var/log/hsync/hsync.log
# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# ProtectHome=read-only allows the service to read files under /home
# (e.g. when HSYNC_PATH points to a user's home directory).
# If you change HSYNC_PATH to a path under /home, you must also add
# that path to ReadWritePaths below (use: systemctl edit hsync.service).
ProtectHome=read-only
ReadWritePaths=/var/lib/hsync /var/lib/hsync/lan_cert /var/log/hsync
ReadOnlyPaths=/etc/hsync

[Install]
WantedBy=multi-user.target
