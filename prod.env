# HSYNC Client - Production Environment Configuration
# Copy this file and customize for your environment

# Server Connection
# URL of the HSYNC server (required)
# Use https:// for encrypted connections (recommended in production)
HSYNC_SERVER=https://your-server.example.com:8765

# API Key for authentication (required)
# Must match the HSYNC_API_KEY configured on the server
# IMPORTANT: Change this to a secure random value in production!
HSYNC_API_KEY=

# Parallel Transfer Settings
# Maximum number of concurrent file transfers (downloads/uploads)
# Higher values increase throughput but also server load
# Range: 1-20, Default: 5
HSYNC_MAX_CONCURRENT_TRANSFERS=5

