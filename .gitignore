# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
**/*.pyc
**/__pycache__
*.pyo

# Virtual environment
.env
*.env
.venv
venv/
ENV/

# Git
.git
.gitignore
.gitattributes

# Unit test / coverage
.coverage
coverage/
htmlcov/
.pytest_cache/
.tox/
.nox/

# Build / Distribution
/build/
/dist/
/tmp/
*.egg-info/
*.egg
*.whl

# IDE settings
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific
.DS_Store
Thumbs.db

# Project specific
/buckets/
/certs/

# Logs
*.log

# Qt specific (for hsync-desktop)
*.qmlc
*.jsc

# PyInstaller — auto-generated spec file (compile.sh removes it on success
# but it can linger if the build is interrupted).
*.spec
# ...but the hand-written RPM spec under packaging/rpm/ must be tracked.
!packaging/rpm/*.spec

# Windows installer — the .ico is generated at build time from the app PNG.
packaging/windows/icon.ico

# compile.sh — wd-ex2-ultra-os5 target
# Icon regenerated by packaging/wd-os5/scripts/generate_icon.py on every
# build. Output goes to the source tree so mksapkg can pick it up.
/packaging/wd-os5/Apkg/hsync.png

# Kilo
.kilo

# Cache
.mypy_cache
.ruff_cache

# HSYNC
.hsynckeep
