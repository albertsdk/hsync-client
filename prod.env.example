# HSYNC Client - Production Environment Configuration (example)
# Copy to prod.env and customize for your environment.

# Server Connection
# Server host (required): a bare host/HOST:PORT or a full https:// URL.
HSYNC_SERVER=localhost:9753

# API Key for authentication (required)
# Must match the HSYNC_API_KEY configured on the server
# IMPORTANT: Change this to a secure random value in production!
HSYNC_API_KEY=

# Parallel Transfer Settings
# Maximum number of concurrent file transfers (downloads/uploads)
# Higher values increase throughput but also server load
# Range: 1-20, Default: 5
HSYNC_MAX_CONCURRENT_TRANSFERS=5

# =============================================================================
# Sync Settings
# =============================================================================

# Ignore delete mode: do not propagate file deletions (backup mode)
# When enabled, local file deletions are not propagated to the server,
# and remote file deletions are not applied locally.
# Useful for backup scenarios where you want to preserve files that are
# deleted on one side.
# Default: false
# HSYNC_IGNORE_DELETE=false

# Compression: enable zstd compression for file transfers
# When enabled, files are compressed before transfer if beneficial
# (skips small files and already-compressed formats like jpg, zip, etc.)
# Default: true
# HSYNC_COMPRESSION_ENABLED=true

# Periodic resync interval in seconds (continuous mode, -w).
# A full sync runs at this interval as a safety net to recover any
# file-system events missed by the watcher (e.g. inotify queue overflow).
# Enabled by default. Set to 0 to disable. Range when set: 20-3600.
# Default: 300
# HSYNC_RESYNC=300

# Mass-deletion guard: pause deletions when a cycle would remove too many
# local files (protects against an empty/wrong master propagating massive
# deletes). A master with 0 files is always treated as a suspect state.
# When tripped, the cycle skips deletions and emits a sync_paused event.
# In production this guard should stay enabled.
# Default: true
HSYNC_MASS_DELETE_GUARD=true

# Absolute number of deletions per cycle that trips the guard
# Set to 0 to disable the absolute threshold (percentage still applies).
# Default: 50
# HSYNC_MASS_DELETE_THRESHOLD=50

# Percentage of total local files whose deletion trips the guard
# Set to 0 to disable the percentage threshold (absolute count still applies).
# Range: 0-100, Default: 50
# HSYNC_MASS_DELETE_PERCENT=50

# =============================================================================
# p2p Mode Settings
# =============================================================================
# These settings are used when running in p2p mode (hsync p2p)
# without a central server.

# p2p TCP listen port for the embedded HTTP server when acting as master
# 0 = use a random available port (recommended)
# Default: 0
# HSYNC_P2P_LISTEN_PORT=0

# Rendezvous timeout in seconds for finding other peers
# How long to wait for peer rendezvous before starting sync
# Default: 10
# HSYNC_RENDEZVOUS_TIMEOUT=10

# Heartbeat interval in seconds
# How often peers send heartbeat signals to indicate they're alive
# Default: 5
# HSYNC_HEARTBEAT_INTERVAL=5

# Peer timeout in seconds
# How long to wait without heartbeat before considering a peer offline
# Should be greater than HEARTBEAT_INTERVAL
# Default: 15
# HSYNC_PEER_TIMEOUT=15

# p2p shared secret for authentication. Two forms (set only one):
#   HSYNC_P2P_PASSPHRASE  user password, at least 12 characters (derived to the key)
#   HSYNC_P2P_KEY         full raw group key, at least 32 characters (used as-is)
# If neither is set, reads are allowed but write-capable sync is refused by default
# IMPORTANT: In production, always set a strong secret!
# HSYNC_P2P_PASSPHRASE=
# HSYNC_P2P_KEY=

# Peer-assisted downloads: continuous slaves publish verified local files and
# request files of any size from exact-hash peers before falling back to the
# master. Defaults: enabled, 2 concurrent seeder bodies, 3 peer attempts.
HSYNC_P2P_PEER_DOWNLOAD=true
HSYNC_P2P_PEER_READ_CAP=2
HSYNC_P2P_PEER_SOURCES_MAX=3

# Dangerous no-key mutation opt-in. Keep false unless every p2p participant is
# trusted and unauthenticated writes are explicitly intended.
HSYNC_P2P_ALLOW_UNAUTHENTICATED_WRITES=false

# Explicit acknowledgement for a keyless p2p run (no shared secret). Peers are
# not authenticated and reads are open to the network. Keep false unless the
# network is fully trusted and the exposure is understood.
HSYNC_P2P_ALLOW_UNAUTHENTICATED=false

# Accept the deletion-risk confirmation non-interactively (e.g. a download-only
# mirror service). The runtime mass-delete guard still applies.
HSYNC_ALLOW_DELETIONS=false

# p2p group name for peer filtering
# Peers with different groups will ignore each other
# If not set, peers see all others regardless of group
# HSYNC_P2P_GROUP=

# Persistent mode: stay active indefinitely waiting for peers
# When enabled (default), the client will keep running even when no peers are found,
# continuously retrying peer rendezvous. Useful for always-on sync services.
# Never become master: when enabled, this client always remains a client/slave
# and is excluded from master election (and advertised as such via mDNS so other
# peers never elect it). Mutually exclusive with --prefer-master. If every peer in
# the group sets this, no master is elected and a [NO MASTER] warning is emitted.
# Default: false
# HSYNC_NEVER_MASTER=false

# =============================================================================
# Log Rotation Settings
# =============================================================================
# These settings apply when using the --output option to log to a file.
# Loguru handles rotation automatically based on these parameters.

# When to rotate the log file
# Examples: "10 MB", "100 MB", "1 GB", "1 day", "1 week", "00:00" (midnight)
# Default: 10 MB
HSYNC_LOG_ROTATION=100 MB

# How long to keep old log files
# Examples: "7 days", "1 month", "3 months", "5" (keep 5 files)
# Default: 7 days
HSYNC_LOG_RETENTION=30 days

# Compression format for rotated logs
# Options: gz, bz2, xz, lzma, tar, tar.gz, tar.bz2, tar.xz, zip
# Default: xz
HSYNC_LOG_COMPRESSION=xz
